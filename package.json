{
  "name": "compost-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet local AI garden for unfinished thoughts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drevendev/CompostClub.git"
  },
  "bugs": {
    "url": "https://github.com/drevendev/CompostClub/issues"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "docs:check": "node scripts/docs-check.mjs",
    "format": "prettier --write src scripts server tests *.json *.ts *.html",
    "format:check": "prettier --check src scripts server tests *.json *.ts *.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run format:check",
    "eval:local": "tsx scripts/eval-local.ts",
    "package:single": "vite build --mode offline && node scripts/package-single.mjs",
    "package:demo": "npm run build && npm run package:single && node scripts/release.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
